#!/usr/bin/env bash
# mine-claims — Extract epistemic claims from repo artifacts and register them in dont
#
# Usage: mine-claims [--dry-run] [--force] [repo-path]
#
# Sources mined:
#   1. Git commit messages (bodies with design rationale)
#   2. README.md (key features, design decisions, documented behavior)
#   3. CHANGELOG.md (notable additions and assertions)
#   4. docs/src/status.md (implementation status assertions)
#   5. Whisper notes (~/.whisper/.../notes.md) — concluded (unverified)
#
set -euo pipefail

DRY_RUN=false
FORCE=false
REPO=""

# ── Options ─────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --force)   FORCE=true; shift ;;
    *)
      [ -z "$REPO" ] && REPO="$1" || { echo "✗ Unexpected arg: $1"; exit 1; }
      shift ;;
  esac
done

[ -z "$REPO" ] && REPO="."
REPO="$(cd "$REPO" 2>/dev/null && pwd)" || { echo "✗ Cannot access repo: $REPO"; exit 1; }
cd "$REPO"

command -v dont &>/dev/null || { echo "✗ 'dont' not found"; exit 1; }
[ -f ".dont/config.toml" ] || { echo "✗ No .dont/ — run 'dont init'"; exit 1; }

# ── Helpers ─────────────────────────────────────────────────────────────────
info() { echo "• $1"; }
warn() { echo "⚠ $1"; }

ground() {
  local claim="$1" file="$2" anchor="$3"
  # Sanitize multi-byte/control chars that dont rejects
  claim="$(echo "$claim" | sed 's/[→⇒←⇐↔⇔─━│┃]/->/g; s/[|]/,/g; s/[$]//g; s/[`]//g; s/—/ -- /g')"
  local short="${claim:0:120}"
  [ "${#claim}" -gt 120 ] && short="${short}…"

  if [ "$DRY_RUN" = true ]; then
    echo "    [DRY-RUN] dont ground \"${short}\" --file $file --anchor \"$anchor\""
    return 0
  fi

  (cd "$REPO" && dont ground "$claim" --file "$file" --anchor "$anchor" 2>&1) | head -1 || {
    warn "Failed to ground claim: ${short}"
    return 1
  }
}

conclude_unverified() {
  local claim="$1"
  claim="$(echo "$claim" | sed 's/[→⇒←⇐↔⇔─━│┃]/->/g; s/[|]/,/g; s/[$]//g; s/[`]//g; s/—/ -- /g')"
  local short="${claim:0:120}"
  [ "${#claim}" -gt 120 ] && short="${short}…"

  if [ "$DRY_RUN" = true ]; then
    echo "    [DRY-RUN] dont conclude \"${short}\""
    return 0
  fi

  (cd "$REPO" && dont conclude "$claim" 2>&1) | head -1 || true
}

# ── Source 1: Git commits (design-significant bodies) ───────────────────────
mine_git_commits() {
  info "Mining git commit messages…"
  # Pick a file that exists in every repo for evidence anchoring
  local evfile="README.md"
  [ -f "$evfile" ] || evfile="CHANGELOG.md"
  [ -f "$evfile" ] || evfile="LICENSE"
  [ -f "$evfile" ] || evfile=".gitignore"
  [ -f "$evfile" ] || evfile="justfile"

  git log --format="%H|%ai|%s" -100 -- . 2>/dev/null | while IFS='|' read -r hash date subject; do
    case "$subject" in "chore:"*|"style:"*|"Merge"*) continue ;; esac
    body="$(git log --format="%b" -1 "$hash" 2>/dev/null | head -10 | tr '\n' ' ' | sed 's/^ *//;s/ *$//')"
    [ -z "$body" ] && body="$subject"
    [ "${#body}" -lt 40 ] && continue
    body="$(echo "$body" | sed 's/[→⇒←⇐↔⇔─━│┃]/->/g; s/[|]/,/g; s/[$]//g; s/[`]//g; s/—/ -- /g')"
    ground "$body" "$evfile" "commit $hash" || true
  done
}

# ── Source 2: README.md ─────────────────────────────────────────────────────
mine_readme() {
  [ ! -f "README.md" ] && return 0
  info "Mining README.md…"
  local name; name="$(basename "$REPO")"
  local in_features=false
  while IFS= read -r line; do
    [[ "$line" == "## Key Features" ]] && { in_features=true; continue; }
    $in_features || continue
    [[ "$line" =~ ^##|^--- ]] && { in_features=false; continue; }
    if [[ "$line" =~ ^-[[:space:]]*\*\*([^*]+)\*\* ]]; then
      local feat="${BASH_REMATCH[1]}"
      local desc="${line#*${feat}**}"
      desc="${desc#\*\*}"; desc="${desc# -- }"; desc="${desc%%.*}"; desc="$(echo "$desc" | xargs)"
      local claim="$name provides $feat"
      [ -n "$desc" ] && claim="$claim: $desc"
      ground "$claim" "README.md" "$feat" || true
    fi
  done < "README.md"
}

# ── Source 3: CHANGELOG.md ──────────────────────────────────────────────────
mine_changelog() {
  [ ! -f "CHANGELOG.md" ] && return 0
  info "Mining CHANGELOG.md…"
  local name; name="$(basename "$REPO")"
  local in_added=false
  while IFS= read -r line; do
    [[ "$line" == "### Added" ]] && { in_added=true; continue; }
    $in_added || continue
    [[ "$line" =~ ^## ]] && { in_added=false; continue; }
    [[ -z "${line// /}" ]] && continue
    if [[ "$line" =~ ^-[[:space:]]*\*\*([^*]+)\*\* ]]; then
      local feat="${BASH_REMATCH[1]}"
      local desc="${line#*${feat}**}"
      desc="${desc#\*\*}"; desc="${desc# -- }"; desc="${desc%%.*}"; desc="$(echo "$desc" | xargs)"
      local claim="$name $feat"
      [ -n "$desc" ] && claim="$claim: $desc"
      ground "$claim" "CHANGELOG.md" "$feat" || true
    fi
  done < "CHANGELOG.md"
}

# ── Source 4: docs/src/status.md ────────────────────────────────────────────
mine_status_doc() {
  local f="docs/src/status.md"
  [ ! -f "$f" ] && return 0
  info "Mining $f…"
  local name; name="$(basename "$REPO")"
  while IFS='|' read -r _ behavior status _; do
    behavior="$(echo "$behavior" | xargs)"; status="$(echo "$status" | xargs)"
    [[ "$behavior" == "Behavior" || "$behavior" =~ ^--- ]] && continue
    [[ -z "$behavior" || -z "$status" ]] && continue
    [[ "$status" == "✅"*"Implemented"* ]] || continue
    ground "$name: $behavior -- implemented and tested" "$f" "$behavior" || true
  done < <(grep '|' "$f" | grep -v '^$')
}

# ── Source 5: Whisper notes (conclude only, external to repo) ───────────────
mine_whisper() {
  local repo_name; repo_name="$(basename "$REPO")"
  local whisper_paths=()
  while IFS= read -r f; do whisper_paths+=("$f"); done < \
    <(find "$HOME/.whisper/repos/" -name "notes.md" -o -name "env.md" 2>/dev/null | grep -i "$repo_name" || true)
  for wpath in "${whisper_paths[@]}"; do
    [ ! -f "$wpath" ] && continue
    info "Mining whisper notes: $wpath"
    while IFS= read -r line; do
      line="$(echo "$line" | sed 's/^  *//')"
      if echo "$line" | grep -qE '^- +(Fixed|Completed|Refactored|Extracted|Key|Bug|Supposition gotcha|Rule of 5)'; then
        local ct; ct="$(echo "$line" | sed 's/^- //' | xargs)"
        [ -n "$ct" ] && conclude_unverified "$ct"
      fi
    done < "$wpath"
    return 0
  done
}

# ── Main ────────────────────────────────────────────────────────────────────
echo "═══════════════════════════════════════════════════════════════"
echo "📋 Mining claims from: $(basename "$REPO")"
echo "═══════════════════════════════════════════════════════════════"
[ "$DRY_RUN" = true ] && echo "⚠  DRY RUN — no claims registered"
echo ""

mine_git_commits
mine_readme
mine_changelog
mine_status_doc
mine_whisper

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ Mining complete"
[ "$DRY_RUN" = true ] && echo "⚠  DRY RUN — no claims registered"
